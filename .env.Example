# Exemplo de arquivo .env para este projeto
# Copie este arquivo para `.env` e preencha os valores sensíveis.

db_host='localhost'
db_user='your_db_user'
db_password='your_db_password'
db_name='clinica'
SECRET_KEY='replace_with_a_random_secret_key'

# Use a MariaDB/MySQL database matching the schema in database/schema.sql
# Copy this file to .env and update the values before starting the app.

# flask-mail settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_password
MAIL_DEFAULT_SENDER=your_email@example.com
