        "responses": {
          "200": {
            "description": "Usuário atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponseEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado"
          }
        }
